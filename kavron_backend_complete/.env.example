APP_NAME=KAVRON Intelligence API
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./kavron.db
MODEL_DIR=./models
DEMO_VIDEO=./data/demo.mp4
DEVICE=cpu
AI_FPS=8
MAX_QUEUE_SIZE=2
CONFIDENCE=0.35
IOU=0.45
MAX_CAMERAS=16
ENABLE_YOLO=true
ENABLE_DEEPSORT=true
KAVRON_AUTOSTART_DEMO=1
JWT_SECRET=change-me

INFERENCE_WORKERS=2
SCHEDULER_QUEUE_SIZE=8
POSE_INTERVAL=2
TRACKER_MAX_AGE=1.5
TRACKER_MAX_DISTANCE=120
BBOX_SMOOTHING=0.65
POSE_SMOOTHING=0.55
KAVRON_CPU_THREADS=2

# Stage 3 multimodel intelligence
STAGE3_ENABLED=true
AUTO_DOWNLOAD_SPECIALIST_MODELS=true
FACE_INTERVAL=4
ANPR_INTERVAL=5
ENABLE_FACE_EMBEDDING=false
ANPR_CONFIDENCE=0.45
BEHAVIOR_LOITER_SECONDS=12
BEHAVIOR_RUNNING_SPEED_PX_S=350
